{"products":[{"id":16169696493899,"title":"The Hourbelle Corset Coat","handle":"hourbelle-corset-coat","body_html":"\u003cp\u003eA winter coat cut like a gown. Hourbelle is a long quilted puffer with a corset-shaped bodice that nips in at your waist and a full bell skirt that swings when you walk - warm like a puffer, shaped like a dress.\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003eCorset-shaped bodice with princess seams and a waist seam that shows your waist\u003c\/li\u003e\n\u003cli\u003eCorset lacing at the back of the waist\u003c\/li\u003e\n\u003cli\u003eDouble-breasted front with fabric-covered buttons and a tall stand-up collar\u003c\/li\u003e\n\u003cli\u003eFull, flared, ankle-length skirt with diamond quilting\u003c\/li\u003e\n\u003cli\u003eLight padded fill, matte outer with a soft sheen\u003c\/li\u003e\n\u003cli\u003eFlap pockets on the hips\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eCare: hand wash in cold water or a gentle cycle in a laundry bag, hang to dry, do not tumble dry.\u003c\/p\u003e","published_at":"2026-11-11T21:48:24+02:00","created_at":"2026-11-11T21:48:21+02:00","updated_at":"2026-11-13T00:25:38+02:00","vendor":"Hourbelle","product_type":"Coat","tags":["hourbelle","hourbelle-niche"],"variants":[{"id":59229326246219,"title":"Black \/ XS","option1":"Black","option2":"XS","option3":null,"sku":"HB-BLK-XS","requires_shipping":true,"taxable":true,"featured_image":{"id":94154141532491,"product_id":16169696493899,"position":2,"created_at":"2026-11-11T21:48:21+02:00","updated_at":"2026-11-11T21:48:25+02:00","alt":"The Hourbelle corset coat in Black, front view","width":1792,"height":2240,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/1093\/0411\/9627\/files\/hourbelle-coat-black.jpg?v=1794426505","variant_ids":[59229326246219,59229326278987,59229326311755,59229326344523,59229326377291,59229326410059]},"available":true,"price":"129.99","grams":1300,"compare_at_price":"259.98","position":1,"product_id":16169696493899,"created_at":"2026-11-11T21:48